M$ModelName = "Teoria_Escalar_Phi4";M$Information = {  Authors -> {"Josias Torre Campos"},  Date -> "11.08.26",  Version -> "1.0",  Description -> "Modelo de prueba para calentar"};M$Parameters = {  lam == {    ParameterType -> External,    Value -> 0.1,    Description -> "Constante de acoplamiento cuartico"  },  Mphi == {    ParameterType -> External,    Value -> 100,    Description -> "Masa del campo escalar"  }};M$ClassesDescription = {  S[1] == {    ClassName -> phi,    SelfConjugate -> True,    Mass -> Mphi,    FullName -> "Campo escalar real"  }};